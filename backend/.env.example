PROJECT_NAME=Medical Report Assistant
API_V1_STR=/api/v1

# MongoDB Configuration Template. Never commit real credentials.
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/?appName=AppName
DATABASE_NAME=Mreport
MONGODB_REQUIRED=true

# System Settings
UPLOAD_DIR=../documents/uploads
LOG_DIR=logs
LOG_FILE=logs/application.log
MAX_FILE_SIZE_MB=25
TESSERACT_CMD=
POPPLER_PATH=
VECTOR_STORE_DIR=backend/data/vector_store

# AI Provider Settings
# xAI example. Replace these values for another OpenAI-compatible provider.
LLM_PROVIDER=xai
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.6
LLM_REQUIRED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DB=faiss
DEFAULT_LANGUAGE=en
